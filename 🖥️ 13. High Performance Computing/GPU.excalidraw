      "updated": 1789427275633,
      "link": null,
      "locked": false,
      "text": "1 MPI rank / GPU   →   CUDA or HIP kernels inside the rank   →   streams + nonblocking MPI for overlap   →   NCCL for GPU collectives",
      "originalText": "1 MPI rank / GPU   →   CUDA or HIP kernels inside the rank   →   streams + nonblocking MPI for overlap   →   NCCL for GPU collectives",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.22
    },
    {
      "id": "gpu-hybrid-0056",
      "type": "text",
