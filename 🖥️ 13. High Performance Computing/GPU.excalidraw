      "versionNonce": 1505511800,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789427277203,
      "link": null,
      "locked": false,
      "text": "Bind rank + CPU cores + GPU + NIC to the same NUMA locality. Measure progress and overlap—do not assume them.",
      "originalText": "Bind rank + CPU cores + GPU + NIC to the same NUMA locality. Measure progress and overlap—do not assume them.",
