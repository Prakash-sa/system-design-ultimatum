    {
      "id": "hUeuH-nfAiG1VV-CzuRJO",
      "type": "text",
      "x": -259.3774736157915,
      "y": -442.86947058105466,
      "width": 445.2480773925781,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
