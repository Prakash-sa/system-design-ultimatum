      "boundElements": null,
      "updated": 1777227815747,
      "link": null,
      "locked": false,
      "text": "Among the key baselines:\n\nFine-tuned GPT: A single-agent system trained end-to-end on conversational data.\n\nGPT-RL: A reinforcement-learning-tuned agent optimizing for success rate.\n\nGPT-RS: A simpler rule-based system with GPT-generated recommendations.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Among the key baselines:\n\nFine-tuned GPT: A single-agent system trained end-to-end on conversational data.\n\nGPT-RL: A reinforcement-learning-tuned agent optimizing for success rate.\n\nGPT-RS: A simpler rule-based system with GPT-generated recommendations.",
      "autoResize": true,
      "lineHeight": 1.25
    }
